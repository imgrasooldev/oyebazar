{
  "name": "@oyebazar/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev --port 3000",
    "build": "next build",
    "build:local": "dotenv -v NEXT_DIST_DIR=.next-local -- next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:security": "vitest run __tests__/security"
