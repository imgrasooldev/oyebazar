    "@oyebazar/ai": "workspace:*",
    "@oyebazar/core": "workspace:*",
    "@oyebazar/db": "workspace:*",
    "@oyebazar/queue": "workspace:*",
    "@oyebazar/shared": "workspace:*",
    "@oyebazar/storage": "workspace:*",
    "@oyebazar/whatsapp": "workspace:*",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
