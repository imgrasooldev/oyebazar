# OyeBazar — live (Fly.io) ke secrets
#
# Isay `.env.production` ke naam se copy karen aur qadrein bhar den. Wo file git se
# bahar hai (.gitignore) aur wahin rehni chahiye — commit kabhi na karen.
#
# Phir chalayen:  node scripts/fly-secrets.mjs
# Wo yahi qadrein Fly ke dono apps par set kar deta hai. Khali khaane chhoot jate hain.

# ---- Database (Supabase — Singapore/ap-southeast-1, taake Fly ke `sin` ke saath rahe)
# Pooled (safhe isi se chalte hain) — Supabase mein "Connection pooling" wala string
DATABASE_URL=""
# Direct (migrations isi se chalti hain) — pooler par migrate deploy nakaam hota hai
DIRECT_URL=""

# ---- App
APP_URL="https://oyebazar.com"
SESSION_COOKIE_NAME="oyebazar_session"
DEFAULT_FEE_RATE_BPS="500"

# ---- WhatsApp
# Abhi tay nahi hua. Khali chhorenge to paighaam SIRF server ke logs mein chhapenge —
# yani asli reseller/dukan wala OTP na milne ki wajah se andar nahi aa sakega.
# 🔴 Is liye jab tak ye na lage, site ka pata kisi ko na den.
WHATSAPP_PROVIDER=""
WATI_API_URL=""
WATI_API_KEY=""
META_PHONE_NUMBER_ID=""
META_ACCESS_TOKEN=""
META_WEBHOOK_VERIFY_TOKEN=""

# ---- Storage (Supabase)
# Bucket public hona chahiye — tasveerein WhatsApp status par jati hain
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_BUCKET="status-packs"
R2_PUBLIC_URL=""

# ---- Redis (Upstash)
# Khali ho to app chalti hai magar status pack RENDER nahi hota — aur wohi is
# karobar ka asal kaam hai.
REDIS_URL=""

# ---- Ops
# 🔴 Khali chhorenge to /api/v1/ops/* band rehte hain (fail closed — ye theek hai).
# Naya banane ke liye: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPS_API_KEY=""

# ---- Soft launch: muqarrar (static) OTP
# 🔴 Ye lagate hi login ka taala kamzor ho jata hai: jo bhi ye code jaan le, wo kisi bhi
# MOJOOD number (reseller ya dukan) se andar aa sakta hai, aur code badalta bhi nahi.
# Sirf us arse ke liye jab tak WhatsApp na lage AUR site ka pata girey huay logon tak
# na pohancha ho. WhatsApp lagte hi ye khana KHALI kar dena hai.
# Ops (admin) is se bahar hai — wahan code phir bhi random rehta hai (logs se parhen).
STATIC_OTP=""

# ---- Cloudflare
# Domain Cloudflare ke PEECHAY (orange cloud) ho to "1" karen — warna rate limit
# sab ko ek hi banda samajhti hai (Fly ko sirf Cloudflare ka IP nazar aata hai).
# 🔴 Cloudflare saamne na ho aur ye "1" ho to koi bhi header bhej kar had se bach
# sakta hai — is liye sirf tab jab waqai Cloudflare lagaya ho.
TRUST_CLOUDFLARE=""

# ---- Status ke lafz (marzi ka) ----
# 🔴 Khali chhorna BILKUL theek hai — kuch band nahi hota.
#
# Reseller ko status ke teen jumle phir bhi milte hain, hamare apne khanon se
# (packages/core/src/domain/pitch.ts): muft, foran, aur har dafa wohi. Key hone par wohi
# jumle Claude likhta hai aur behtar hote hain — aur model us lamhe nakaam ho jaye to
# jawab khud-ba-khud template par gir jata hai.
ANTHROPIC_API_KEY=""

# ---- Worker
RENDER_CONCURRENCY="4"
