# ---- Database ----
# Default: local Postgres jo `pnpm db:local` chalata hai (koi install nahi chahiye).
# Neon/Supabase par jana ho to bas ye do lines badal dein.
DATABASE_URL="postgresql://oyebazar:oyebazar@localhost:5433/oyebazar"
DIRECT_URL="postgresql://oyebazar:oyebazar@localhost:5433/oyebazar"

# ---- App ----
APP_URL="http://localhost:3000"
SESSION_COOKIE_NAME="oyebazar_session"
# NODE_ENV yahan set NA karen. Next/Node khud set karte hain (dev par development,
# `next build`/`next start` par production). Agar yahan "development" para reh jaye to
# production build tootti hai aur session cookie `secure` nahi rehti — dono khamoshi se.

# ---- Fee ----
# basis points: 500 = 5%, 800 = 8%
DEFAULT_FEE_RATE_BPS=500

# ---- WhatsApp (dev: console | Phase 1: wati | Phase 2: meta) ----
# console par OTP terminal mein chhapta hai — koi asli message nahi jata
WHATSAPP_PROVIDER="console"
WATI_API_URL=""
WATI_API_KEY=""
META_PHONE_NUMBER_ID=""
META_ACCESS_TOKEN=""
META_WEBHOOK_VERIFY_TOKEN=""

# ---- Storage ----
# Ye dono khali hon to worker LOCAL DISK use karta hai:
# apps/web/public/_dev-media — image seedha localhost:3000 se serve hoti hai.
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_BUCKET="status-packs"
R2_PUBLIC_URL="http://localhost:3000/_dev-media"

# ---- Redis (Upstash / Fly Redis) ----
# Khali ho to app chalti hai magar status pack render nahi hota (queue log-only mode).
# Bina Redis ke render dekhne ke liye: pnpm --filter @oyebazar/worker daily:dev
REDIS_URL=""

# ---- Ops API (Retool) ----
# 🔴 Khali chhorenge to /api/v1/ops/* BAND rehte hain (fail closed).
OPS_API_KEY=""

# ---- Worker ----
# Playwright contexts: CPU cores × 1.5, max 8. Har context ~80MB.
RENDER_CONCURRENCY="2"
