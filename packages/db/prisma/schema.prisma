// Baji — database schema
//
// Do database-level qawaid (docs/CONVENTIONS.md):
//   1. Paisa hamesha Int (PKR). Float/Decimal kabhi nahi.
//   2. Har OrderItem par price SNAPSHOTS lazmi — history badalni nahi chahiye.
//
// Naming: PascalCase models, camelCase fields.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Neon: pooler ke bajaye migrations direct connection se
}

// ============================================================ SUPPLIERS

model Supplier {
  id               String         @id @default(cuid())
  slug             String         @unique // Bazaar URL: /bazaar/<slug>
  businessName     String
  ownerName        String
  phone            String         @unique // internal — kabhi public nahi
  // Bazaar par ye number jaan boojh kar public hai (directory ki value yehi hai)
  whatsappPublic   String?
  ntn              String? // ⚠ FBR — seller of record wohi hai
  strn             String?
  address          String
  city             String
  marketName       String? // "Bolton Market"
  bioUr            String?
  logoUrl          String?
  bankAccount      String?
  // 🔴 Bazaar par sirf listed + VERIFIED suppliers dikhte hain
  listedOnBazaar   Boolean        @default(false)
  /**
   * Dukan ka apna waada: delivery ke kitne din baad reseller ko paise deta hai.
   * 0 = usi din. Hadd 7 din (service mein).
   * 🔴 Ghari DELIVERY se chalti hai, order se nahi. COD mein paisa dukan ke haath
   * delivery par aata hai — "order ke do din baad" ka matlab apni jeb se dena hai,
   * aur wo waada pehle hi din tootta hai.
   */
  payoutTermDays   Int            @default(3)
  /**
   * Delivery ka rate — do khaane, kyunke courier ka bill bhi do tarah ka hota hai.
   * 🔴 Rate wohi likhta hai jo courier ka bill bharta hai. Pehle ye reseller order lagate
   * waqt khud likhti thi (default 200): sheher ka koi farq nahi tha, aur wo 0 likh deti to
   * nuqsan chup chaap dukan ke zimme aa jata — jis par us ka koi bas hi nahi tha.
   */
  deliveryFeeCity  Int            @default(200)
  deliveryFeeOther Int            @default(350)
  feeRateBps       Int            @default(500) // 500 = 5% · per-supplier negotiate ho sakta hai
  status           SupplierStatus @default(PENDING)
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  products     Product[]
  orders       Order[]
  reviews      SupplierReview[]
  sessions     Session[]
  contentPacks ContentPack[]
  feeLedger    FeeLedger[]
  payouts      ResellerPayout[]
  stockMoves   StockMove[]
  warehouses   Warehouse[]
  stockBatches StockBatch[]

  @@index([status, city])
  @@index([listedOnBazaar, status])
}

enum SupplierStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

// ============================================================ CATALOGUE

/// Categories ka darakht — do darjay: "Electronics" ke neeche "Fans", "Solar" waghera.
/// Sirf DO darjay jaan boojh kar: teen darjay ke menu mein khareedar kho jata hai.
model Category {
  id        String  @id @default(cuid())
  slug      String  @unique
  nameUr    String
  nameEn    String
  /// Category ki apni tasveer — taake nayi category jis mein abhi maal nahi,
  /// wo bhi khaali dabba na lage. Na ho to pehle product ki tasveer chalti hai.
  imageUrl  String?
  sortOrder Int     @default(0)

  /// null = ye khud aik badi category hai
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  /**
   * Materialised path — jarh se yahan tak ka rasta, IDs mein: "/root/child/yeh/"
   * 🔴 Ye khaana isliye hai ke darakht ab kitna bhi gehra ja sakta hai. Adjacency list
   * (sirf parentId) se "is category aur us ke NEECHE ka saara maal" nikalne ke liye
   * har darje par ek query lagti hai — pehle code do darjay farz kar ke chal raha tha
   * (`{ OR: [{ slug }, { parent: { slug } }] }`), aur teesra darja banate hi us ka maal
   * ghaib ho jata.
   * Path se wohi sawal ek shart mein hal hota hai: `path startsWith us ka path`.
   * IDs rakhe hain, slug nahi: naam badalna aam hai aur us se poora darakht dobara
   * likhna parta. Path sirf JAGAH badalne par badalta hai.
   */
  path  String @default("/")
  /// Jarh = 0. Sirf dikhane aur hadd lagane ke liye — sach `path` mein hai.
  depth Int    @default(0)

  products Product[]

  @@index([parentId, sortOrder])
  @@index([sortOrder])
  // "Is shaakh ka saara maal" — sab se aam sawal, isi index par chalta hai
  @@index([path])
}

model Product {
  id              String        @id @default(cuid())
  slug            String        @unique // public URL
  supplierId      String
  titleUr         String
  titleEn         String
  descriptionUr   String?
  categoryId      String
  // 🔴 supplierPrice reseller-facing kisi query mein select NA ho — packages/db/src/selectors.ts
  supplierPrice   Int
  bajiPrice       Int // reseller ise dekhti hai (supplierPrice + fee)
  suggestedRetail Int
  status          ProductStatus @default(DRAFT)
  /// Talash ka apna khana — saaf shuda (titleUr + titleEn + tafseel + category ka naam).
  ///
  /// 🔴 Sawal aur maal DONO ek hi tarah saaf hone chahiyen (packages/shared/search-terms.ts).
  /// Sirf sawal saaf karne se mehnat zaya ho jati hai: Arabi "ك" ya zer-zabar wale naam
  /// par likhne wale ko maal kabhi nahi milta. Ye qadar likhte waqt banti hai, parhte
  /// waqt nahi — is liye har talash par DB ko kuch calculate nahi karna parta.
  searchText      String        @default("")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  supplier        Supplier             @relation(fields: [supplierId], references: [id])
  category        Category             @relation(fields: [categoryId], references: [id])
  variants        ProductVariant[]
  media           ProductMedia[]
  priceRequests   PriceChangeRequest[]
  addressRequests AddressRequest[]

  @@index([status, categoryId])
  @@index([supplierId, status])
  @@index([status, createdAt])
}

enum ProductStatus {
  DRAFT
  LIVE
  OUT_OF_STOCK
  ARCHIVED
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  size      String?
  colour    String?
  skuCode   String  @unique
  stockQty  Int     @default(0)

  /// Is se neeche girte hi "khatam hone wala hai" ka ishara — 0 = ishara band.
  ///
  /// 🔴 Dukan ke apne haath mein hai, hamare andaze mein nahi. Kirane wale ke liye 50
  /// bori kam hai aur jeweller ke liye 2 set bohat. Ek muqarrar number sab par lagana
  /// aadhon ko rozana bekar ka ishara bhejta aur baqi aadhon ko kabhi kuch na batata.
  reorderLevel Int @default(0)

  /// Ek piece ki AOSAT lagat — sirf wahan se banti hai jahan dukan ne khud batayi ho.
  ///
  /// 🔴 Ye `Product.supplierPrice` (bechne ka rate) se ALAG cheez hai: wo kis rate par
  /// bech raha hai, ye kis rate par khareeda tha. Munafa dono ka farq hai, aur us se
  /// pehle wo kahin likha hi nahi tha.
  ///
  /// 0 = kabhi lagat batayi hi nahi — us soorat mein hum maal ki qeemat ka koi andaza
  /// NAHI dikhate. Ghalat qeemat dikhane se kuch na dikhana behtar hai.
  avgCost Int @default(0)

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   ProductMedia[]
  moves   StockMove[]
  stock   VariantStock[]
  batches StockBatch[]

  @@index([productId])
  // "Khatam hone wala maal" ki list — dukan ka safha isi par khara hai
  @@index([stockQty])
}

/**
 * Godown — dukan ki jagah jahan maal para hai.
 * 🔴 Har dukan ka kam se kam EK godown hota hai (`isDefault`), chahe us ne kabhi is
 * safhe ko khola bhi na ho. Ye "khali chhorne" wale raste se behtar hai: bina default
 * ke har query ko do soorton mein sochna parta ("godown hai ya nahi"), aur wohi jagah
 * hai jahan kuch arse baad ek soorat bhool jati hai aur ginti gum ho jati hai.
 * Aam Pakistani thok dukan par do hi hote hain: saamne wali dukan, aur peechhe ka
 * store. Is liye yahan koi darakht nahi (godown ke andar godown), sirf ek saadi list —
 * aur us se aage jane ki zaroorat us din dekhi jayegi jis din waqai koi maange.
 */
model Warehouse {
  id         String  @id @default(cuid())
  supplierId String
  name       String
  /// Bina bataye maal yahin se nikalta hai — har dukan par theek EK
  isDefault  Boolean @default(false)
  /// Band godown mein naya maal nahi daala ja sakta; jo para hai wo phir bhi bikta hai
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())

  supplier Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  stock    VariantStock[]
  moves    StockMove[]
  batches  StockBatch[]

  /// Ek dukan par ek naam ek hi dafa — warna "Store" naam ke do godown ban jate hain
  @@unique([supplierId, name])
  @@index([supplierId, sortOrder])
}

/**
 * Kis godown mein kitna — ginti ka ASAL sach.
 * 🔴 `ProductVariant.stockQty` ab in qataron ka JAMA hai, aur wo usi transaction mein
 * likha jata hai jis mein ye qatar badalti hai. Wo khaana mita kar sirf yahan se jama
 * lagana zyada "saaf" lagta hai — magar wo bechne wale raste ko tor deta:
 * · `reserve` ki shart (`stockQty >= qty`) ek hi row par ek hi atomic update hai; wohi
 * cheez do resellers ko ek hi aakhri piece bechne se rokti hai. SUM par wo shart
 * lagana mumkin nahi — aur us ke baghair stock manfi mein chala jata hai.
 * · reseller ke catalogue ki har chhanni (`inStockOnly`), listing ka LIVE/OUT_OF_STOCK,
 * aur "kitna bacha hai" — sab us ek khaane par khare hain.
 * Is liye do jagah likha jata hai, magar KABHI alag nahi ho sakta: dono ek hi transaction
 * mein badalte hain, aur register (`StockMove`) mein us ki qatar bhi wahin banti hai.
 */
model VariantStock {
  id          String @id @default(cuid())
  variantId   String
  warehouseId String
  qty         Int    @default(0)

  updatedAt DateTime @updatedAt

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  /// Ek cheez, ek godown, ek qatar
  @@unique([variantId, warehouseId])
  @@index([warehouseId])
}

/**
 * Khep — ek dafa aaya hua maal, apni maddat ke saath.
 * 🔴 Ye ginti ka TEESRA paimana NAHI hai. Bechne ka faisla `ProductVariant.stockQty` par
 * hai (atomic shart) aur jagah `VariantStock` par; khep sirf NIGRANI ki cheez hai:
 * "ye maal kab tak theek hai".
 * Us faisle ki wajah bechne ke raste ki hai. Har naya taala us raste par wo jagah hai
 * jahan ginti manfi mein ja sakti hai — aur wahi ek cheez hai jo do resellers ko ek hi
 * aakhri piece bechne se rokti hai. Is liye:
 * · khep kabhi bikri nahi rokti
 * · khep ki ginti KAM ho sakti hai (dukan ne har cheez khep ke saath na daali ho), aur
 * us soorat mein bhi sab theek chalta hai — bas us hissay par maddat ka ishara nahi
 * 🔴 Aur kapre wali dukan par ye khana nazar bhi nahi aata. Lawn ke suit ki koi maddat
 * nahi hoti; jo dukan khep likhti hi nahi, us ke liye ye poora hissa ghayab rehta hai.
 */
model StockBatch {
  id          String  @id @default(cuid())
  supplierId  String
  variantId   String
  /// Kis godown mein aayi — khali bhi ho sakta hai (purani qataren)
  warehouseId String?

  /// Dukan ka apna lot/batch number — jo dabbe par likha hota hai
  batchNo  String?
  /// Maddat — khali = is cheez par ye sawal banta hi nahi (kapra, bartan)
  expiryAt DateTime?

  /// Kitna aaya tha
  qtyIn    Int
  /// Kitna baqi hai — FEFO tarteeb mein ghatta hai
  qtyLeft  Int
  /// Is khep ka apna rate — `ProductVariant.avgCost` se alag, us khep ka sach
  unitCost Int?

  receivedAt DateTime @default(now())
  note       String?

  supplier  Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse?     @relation(fields: [warehouseId], references: [id])

  /// FEFO: jo pehle kharab hogi wo pehle. Khali khep tarteeb mein aati hi nahi.
  @@index([variantId, expiryAt])
  /// "Kya maddat khatam hone wali hai" — dukan ka apna safha isi par khara hai
  @@index([supplierId, expiryAt])
}

/**
 * Ginti ki har harkat — ek qatar, hamesha ke liye.
 * 🔴 Update kabhi nahi, sirf insert — bilkul `OrderEvent` ki tarah. Ginti badalna is
 * nizam ka sab se KHAMOSH amal hai: na koi paighaam jata hai, na koi safha alag nazar
 * aata hai. Pehle sirf aakhri number mehfooz tha, aur "20 the, ab 4 hain — beech mein
 * kya hua?" ka jawab kisi ke paas nahi tha. Us sawal ka jawab teen jagah zaroori hai:
 * · Dukan ke apne hisab mein — maal bika, ya toota, ya ginti hi ghalat thi?
 * · Jhagre mein — reseller kehti hai order laga tha, dukan kehti hai maal tha hi nahi.
 * · Ops ki chhanni mein — jis maal ki ginti roz haath se badalti ho wo mashkook hai.
 * `balanceAfter` jaan boojh kar mehfooz hai (hisab dobara nahi lagate): register purana
 * hone par bhi har qatar apne waqt ka sach batati rehti hai, aur agar kabhi jama-tafreeq
 * `ProductVariant.stockQty` se na mile to wo khud ek khabar hai — jise dhoondna warna
 * mumkin hi na hota.
 */
model StockMove {
  id         String @id @default(cuid())
  supplierId String
  productId  String
  variantId  String

  /// + maal aaya, − maal gaya. Sifar kabhi nahi (bemani qatar).
  delta        Int
  /// Is harkat ke BAAD ki ginti — us waqt ka snapshot
  balanceAfter Int
  reason       StockMoveReason

  /// Kis order ki wajah se — order wali harkat par lazmi, warna khali.
  ///
  /// 🔴 `orderNo` (BJ-1043), `orderId` nahi. Do wajah: ginti order BANNE se PEHLE rok
  /// li jati hai (warna do resellers ek hi aakhri piece bech deti hain), is liye us
  /// lamhe id mojood hi nahi hoti — aur register dukan wala khud parhta hai, jahan wo
  /// wohi number dhoondta hai jo us ke saamne har jagah likha hota hai.
  orderNo  String?
  /// Naya maal aane par: ek piece kitne ka para. `avgCost` isi se banti hai.
  unitCost Int?

  /**
   * Kis khep se nikla / kis khep mein aaya.
   * Khali reh sakta hai aur wo aam soorat hai: jo dukan khep likhti hi nahi (kapra,
   * bartan) us ki har qatar par ye khali hoga. Ye us par koi shart nahi lagata.
   */
  batchId String?
  note    String?

  /**
   * Kis godown se / mein.
   * Purani qataron par khali hai (register godown se pehle bana tha) — aur wo khali
   * jagah jaan boojh kar khali rehti hai. Unhen default godown ka naam de dena aisa
   * dawa hota jo hum jante hi nahi; register ka poora faida usi baat mein hai ke us mein
   * likha hua sirf wo ho jo waqai hua.
   */
  warehouseId String?

  /// supplier | ops | system — wohi lafz jo `OrderEvent.actorType` mein chalte hain
  actorType String
  actorId   String?
  createdAt DateTime @default(now())

  supplier  Supplier       @relation(fields: [supplierId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse?     @relation(fields: [warehouseId], references: [id])

  // Dukan ka register — naya sab se upar
  @@index([supplierId, createdAt])
  // Ek cheez ki apni tareekh
  @@index([variantId, createdAt])
  @@index([productId, createdAt])
  // Jhagre mein: is order par ginti ka kya hua
  @@index([orderNo])
}

enum StockMoveReason {
  /// Pehli ginti — jo maal register shuru hone se pehle se para tha
  OPENING
  /// Naya maal aaya (khareeda / factory se utra)
  STOCK_IN
  /// Order laga — maal rok liya gaya
  ORDER_RESERVED
  /// Order mar gaya (mansookh / dukan ne mana kiya) — maal wapas ginti mein
  ORDER_RELEASED
  /// Parcel wapas aaya aur maal dobara shelf par rakh diya gaya
  RETURN_TO_SHELF
  /// Dukan ne khud ginti theek ki — asli ginti aur register ka farq
  MANUAL_FIX
  /// Toot gaya / kharab ho gaya / gum ho gaya
  DAMAGE

  /// Ek godown se nikla
  ///
  /// 🔴 Transfer par DO qataren banti hain, ek nahi — dono ek hi transaction mein.
  /// Ek qatar ("godown A se godown B") likhne se har godown ki apni tareekh adhoori reh
  /// jati: godown B ka register kholne par us mein wo maal aata hua nazar hi na aata.
  TRANSFER_OUT
  /// Doosre godown mein aya
  TRANSFER_IN
}

/// 🔴 LIVE maal ka rate badalne ki darkhwast — faisla ops ka hai, dukan wale ka nahi.
///
/// Wajah: rate barhte hi `bajiPrice` barhta hai, aur jis reseller ne is maal par apna
/// retail rate save kar rakha hai wo ab apni lagat se NEECHE bech rahi hoti hai — us ka
/// status pack pehle se WhatsApp par laga hua hai aur usay khabar tak nahi hoti. Ye
/// nuqsan itla se nahi rukta; is ka faisla pehle hona chahiye.
///
/// DRAFT par ye table nahi chalti — wahan dukan wala khud sab kuch badal sakta hai,
/// kyunke na ops ne dekha hai na kisi reseller ne.
model PriceChangeRequest {
  id         String @id @default(cuid())
  productId  String
  supplierId String

  /// Darkhwast ke waqt ka rate — faisla baad mein hota hai, tab tak rate badal sakta hai
  currentSupplierPrice   Int
  requestedSupplierPrice Int
  reason                 String?

  status       PriceChangeStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  decidedAt    DateTime?
  decidedBy    String?
  decisionNote String?

  /// 🔴 Ek maal par ek hi KHULI darkhwast — magar guzri hui saari mehfooz.
  ///
  /// Ye khaana PENDING ke doran `productId` rakhta hai aur faisle ke baad `null` ho
  /// jata hai. Postgres ke unique index mein NULL kisi doosre NULL se nahi takrata, is
  /// liye ek maal ki das APPROVED/REJECTED rows araam se rehti hain magar doosri PENDING
  /// nahi ban sakti.
  ///
  /// `@@unique([productId, status])` ghalat hota: us se guzri hui darkhwast bhi ek hi
  /// reh sakti thi, yani har nayi manzoori purani ka nishan mita deti — aur "kis ne kab
  /// kis rate ki ijazat di" ka jawab hamesha ke liye kho jata.
  pendingProductId String? @unique

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([supplierId, status])
  @@index([productId, createdAt])
}

enum PriceChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProductMedia {
  id             String    @id @default(cuid())
  productId      String
  /**
   * Kis rang/size ki tasveer — null = poore maal ki.
   * 🔴 Ye khaana pehle se mojood tha magar MARA HUA tha: na koi likhta tha na parhta.
   * Ab zinda hai — "Red" ki apni tasveer hoti hai, taake reseller ke status pack aur
   * catalogue par wohi rang jaye jo customer ne maanga. Us ke baghair har rang ki ek
   * hi tasveer jati thi aur customer ko milne par farq pata chalta.
   */
  variantId      String?
  originalUrl    String
  processedUrl   String?
  type           MediaType @default(IMAGE)
  sortOrder      Int       @default(0)
  // Content Studio kis image par template lagata hai
  isStatusSource Boolean   @default(false)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  /**
   * Variant mit jaye to tasveer nahi marti — poore maal ki ho jati hai (SetNull).
   * Cascade rakhte to ek jorha hatate hi us ki tasveerein bhi chali jatin, aur wo
   * aksar wahi tasveerein hoti hain jo dobara chahiye hoti hain.
   */
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@index([variantId])
}

enum MediaType {
  IMAGE
  VIDEO
}

// ============================================================ RESELLERS

model Reseller {
  id            String         @id @default(cuid())
  name          String
  whatsappPhone String         @unique // E.164 without + (923001234567)
  city          String
  area          String?
  payoutMethod  PayoutMethod?
  payoutAccount String? // UI par hamesha masked
  status        ResellerStatus @default(ACTIVE)
  codEnabled    Boolean        @default(true)
  /**
   * Kis behen ne bulaya — us ki apni `id`.
   *
   * 🔴 Ye khaana MAHINON tak mara hua para tha: banaya gaya, kabhi likha nahi
   * gaya, kabhi parha nahi gaya. Aisa code jo zinda dikhta ho, aam mare hue code se
   * khatarnak hai — koi us par bharosa kar ke feature bana leta hai jo chala hi nahi.
   *
   * Ab ye register ke waqt bharta hai (`/join?ref=<id>`) aur dashboard par dikhta hai.
   * Alag "referral code" ka khaana jaan boojh kar nahi banaya: `id` pehle se mojood hai
   * aur us ke jaanne se kuch milta nahi — wo sirf ye batati hai ke kis ne bulaya.
   */
  referredById  String?
  lastActiveAt  DateTime?
  createdAt     DateTime       @default(now())

  /// Status pack ke default faislay — Studio har naye pack par yahin se shuru karta hai.
  ///
  /// Alag khaane (aur profile ke `name`/`whatsappPhone` ka istemal nahi) is liye ke ye
  /// DO alag cheezein hain: `whatsappPhone` wo number hai jis par ye LOGIN karti hai aur
  /// jis par hum isay paighaam bhejte hain; `packPhone` wo hai jo tasveer par duniya ko
  /// dikhta hai. Bohat si resellers apna zaati number chhupa kar karobar ka number
  /// chhapwati hain — aur login ka number badal dena us ka bilkul ghalat hal hota.
  packLang        String  @default("ur")
  packShowName    Boolean @default(true)
  packShowPhone   Boolean @default(true)
  packShowPrice   Boolean @default(true)
  /// Khali = profile ka `name` / `whatsappPhone`.
  packName        String?
  packPhone       String?
  /// Kaun sa template default hai — built-in ki key (`sale`) ya apna (`custom:<id>`).
  /// Khali = system ka default (`simple`). Studio aur raat ki pre-generation dono yahi dekhte hain.
  packTemplateKey String?

  pricing         ResellerPricing[]
  payouts         ResellerPayout[]
  orders          Order[]
  customers       Customer[]
  bonuses         ResellerBonus[] @relation("BonusEarner")
  reviews         SupplierReview[]
  statusPacks     StatusPack[]
  sessions        Session[]
  templates       ResellerTemplate[]
  addressRequests AddressRequest[]

  @@index([status, city])
  @@index([lastActiveAt])
}

enum ResellerStatus {
  ACTIVE
  LIMITED
  SUSPENDED
}

enum PayoutMethod {
  JAZZCASH
  EASYPAISA
}

/**
 * Reseller ka bonus — platform ki taraf se, dukan ki taraf se NAHI.
 *
 * 🔴 Ye `ResellerPayout` se BILKUL alag cheez hai aur dono ka alag rehna
 * lazmi hai. Payout dukan ka paisa hai jo us ne wasool kiya aur reseller ko dena hai;
 * bonus HAMARA kharcha hai. Ek hi table mein rakhne ka matlab ye hota ke koi din
 * "reseller ko kitna dena hai" ka jawab do alag jeb milaa kar deta — aur jis din wo
 * hisab bigarta, us din pata hi na chalta ke paisa kis ka tha.
 */
model ResellerBonus {
  id         String      @id @default(cuid())
  resellerId String
  kind       BonusKind
  /// Rupay — snapshot. Qaida kal badle to purani rows nahi badalteen.
  amount     Int
  /**
   * Kis order par khula.
   *
   * 🔴 SIGNUP par ye us reseller ka apna order hai; REFERRAL par ye us NAYI
   * behen ka pehla order hai jise is ne bulaya. Dono soorton mein wo ek asli, POHANCH
   * chuka order hai — bonus kabhi lagaye hue order par nahi khulta.
   */
  orderId    String
  /**
   * Kaun aayi — sirf REFERRAL par.
   *
   * 🔴 `@unique` yehi shart nibhata hai ke ek bulai hui behen par bonus SIRF
   * EK DAFA khule. Postgres mein kai `null` ek saath chal jate hain, is liye SIGNUP wali
   * qatarein aapas mein nahi takratin.
   */
  fromResellerId String? @unique

  status        BonusStatus @default(PENDING)
  paidAt        DateTime?
  /// EasyPaisa/bank ka TID — jhagre mein yehi ek cheez asli hai
  paidReference String?
  createdAt     DateTime    @default(now())

  reseller Reseller @relation("BonusEarner", fields: [resellerId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id])

  /// Ek order par ek hi qism ka bonus — dobara chalne par nayi qatar nahi banti
  @@unique([kind, resellerId, orderId])
  /// Ops ki screen: sab se purana baqaya sab se upar
  @@index([status, createdAt])
  @@index([resellerId, createdAt])
}

enum BonusKind {
  /// Nayi reseller ke apne pehle order — 10 orderon tak
  SIGNUP
  /// Kisi ko bulane par — us ke pehle order par, ek dafa
  REFERRAL
}

enum BonusStatus {
  PENDING
  PAID
}

model ResellerPricing {
  id          String   @id @default(cuid())
  resellerId  String
  productId   String
  retailPrice Int
  updatedAt   DateTime @updatedAt

  reseller Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  @@unique([resellerId, productId])
  @@index([productId])
}

// ============================================================ STATUS PACKS

/// Reseller ka apna banaya hua template.
///
/// 🔴 `spec` mein CSS NAHI hai — ek tay-shuda shakal hai (rang, jagah, naap) jise
/// `packages/shared/template-spec.ts` CSS mein badalta hai. Wajah wahan likhi hai:
/// ajnabi ka CSS hamare render HTML mein nahi jana chahiye.
///
/// `revision` cache key ka hissa ban kar `templateKey` mein jata hai (`custom:<id>@<n>`).
/// Iske baghair reseller apna template badalti aur usay purani (pehle wali) tasveer hi
/// milti rehti — kyunke cache ki nazar mein key wohi purani hoti.
model ResellerTemplate {
  id         String   @id @default(cuid())
  resellerId String
  name       String
  spec       Json
  /// Har save par barhta hai — purani tasveerein apni jagah rehti hain, nayi alag banti hai.
  revision   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reseller Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  @@index([resellerId, updatedAt])
}

model StatusPack {
  id          String @id @default(cuid())
  resellerId  String
  productId   String
  /// Kis tasveer par pack bana — ek product ki kai tasveerein hoti hain.
  ///
  /// 🔴 Khali string ka matlab "product ki cover tasveer", `null` nahi. Postgres ke
  /// unique index mein NULL kisi doosre NULL se nahi takrata, yani nullable rakhte to
  /// cover wale packs ka cache constraint chup chaap kaam karna chhor deta aur ek hi
  /// pack ki do rows ban jatin.
  mediaId     String @default("")
  templateKey String
  priceUsed   Int
  // story (9:16) | square (1:1) | portrait (4:5) | wide (1.91:1) — packages/shared/pack-kit.ts
  format      String @default("story")

  /// Reseller ke apne faislay — zaban, aur kya kya tasveer par chhape.
  ///
  /// 🔴 `optionsKey` cache key ka hissa hai; baqi khaane render ke liye hain. Dono
  /// zaroori hain: key ke baghair "number hata den" wala pack purani (number wali)
  /// tasveer wapas de deta, aur khaanon ke baghair ruka hua pack dobara render karte
  /// waqt hum bhool jate ke us par kya chhapna tha.
  ///
  /// Default par optionsKey KHALI hai — packages/shared/pack-options.ts. Is se pehle se
  /// bane hue laakhon packs apni jagah qaim rehte hain aur dobara render nahi hote.
  optionsKey   String  @default("")
  packLang     String  @default("ur")
  showName     Boolean @default(true)
  showPhone    Boolean @default(true)
  showPrice    Boolean @default(true)
  /// Khali = profile ka naam/number.
  overlayName  String?
  overlayPhone String?

  imageUrl     String? // null = abhi render ho raha hai
  videoUrl     String?
  generatedAt  DateTime?
  downloadedAt DateTime?
  sharedCount  Int       @default(0)
  createdAt    DateTime  @default(now())

  reseller Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  // 🔴 CACHE KEY — wohi reseller + product + template + price + naap = wohi image, dobara
  // render nahi. Format is mein shamil hai warna Instagram ka chokor pack WhatsApp ke
  // lambe pack ko cache mein overwrite kar deta.
  // `name` client ka accessor hai (repository is se `where` banati hai), `map` Postgres
  // ka index naam — Postgres khud 63 haroof par kaat deta hai, is liye saaf naam diya hai.
  @@unique([resellerId, productId, mediaId, templateKey, priceUsed, format, optionsKey], name: "cacheKey", map: "StatusPack_cache_key")
  @@index([resellerId, createdAt])
  @@index([imageUrl, createdAt])
}

// ============================================================ DAILY DROP

/// "آج کا اسٹیٹس پیک" — har din ke 5 items.
///
/// Ye alag table isliye hai ke teen alag cheezein ek hi list par ittefaq karen:
/// raat 3 baje ki pre-generation, subah 9 baje ka broadcast, aur app ka home screen.
/// Warna reseller ko message kuch aur milta hai aur app mein kuch aur dikhta hai.
model DailyDrop {
  id        String     @id @default(cuid())
  /// ek din ka ek hi drop
  dropDate  DateTime   @unique @db.Date
  status    DropStatus @default(DRAFT)
  /// broadcast kab gaya (null = abhi nahi gaya)
  sentAt    DateTime?
  sentCount Int        @default(0)
  createdAt DateTime   @default(now())

  items DailyDropItem[]

  @@index([status, dropDate])
}

enum DropStatus {
  DRAFT
  SCHEDULED
  SENT
}

model DailyDropItem {
  id        String @id @default(cuid())
  dropId    String
  productId String
  sortOrder Int    @default(0)

  drop DailyDrop @relation(fields: [dropId], references: [id], onDelete: Cascade)

  @@unique([dropId, productId])
  @@index([productId])
}

// ============================================================ ORDERS

/**
 * Reseller ka apna customer — us ka sab se bara asset.
 *
 * 🔴 Ye REESELLER KE SAATH bandha hua hai, platform ke saath nahi
 * (`@@unique([resellerId, phone])`). Ye faisla privacy ka hai, saholat ka nahi.
 *
 * Ek sanjha (global) customer rakhne ka matlab hota ke reseller A, B ke customer ka
 * NAAM aur PATA dekh le — sirf us ka number likh kar. Wo hamara data nahi hai jo hum
 * baant den; wo us aurat ki apni mehnat se bani hui fehrist hai. Aur wohi cheez
 * platform ko sab se pehle chhorne ki wajah banti hai.
 *
 * Jo cheez SANJHI honi chahiye wo pehle se sanjhi hai aur alag rasta rakhti hai:
 * `phoneRecord()` — us number par kitne order pohanche aur kitne wapas aaye. Wahan se
 * sirf GINTI bahar jati hai, koi naam, koi pata, kisi doosre ka koi order nahi.
 *
 * 🔴 `Order` par customer ke khaane (naam, phone, pata) JYON KE TYON rehte
 * hain, aur wo nakal nahi hai — wo SNAPSHOT hai. Customer kal apna pata badal le to
 * purana parcel usi purane pate par gaya tha, aur jhagre ke din sawal yehi hota hai ke
 * "us waqt kya likha tha". Yahan sirf AAKHRI haal rehta hai (agli dafa bharne ke liye);
 * har order ka apna sach us ke apne khaanon mein.
 */
model Customer {
  id         String @id @default(cuid())
  resellerId String
  /// Local shakl mein, wohi jo reseller ne likha — `phoneKey()` se guzra hua
  phone      String
  name       String
  address    String
  area       String

  /// Aakhri dafa kab kuch khareeda — "purani customer" isi se maloom hoti hai
  lastOrderAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reseller Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  orders   Order[]

  /// Ek reseller ke haan ek number ek hi customer
  @@unique([resellerId, phone])
  /// Us ki apni fehrist — nayi khareedari sab se upar
  @@index([resellerId, lastOrderAt])
}

model Order {
  id              String        @id @default(cuid())
  orderNo         String        @unique // BJ-1043
  resellerId      String
  supplierId      String
  /**
   * Customer ka SNAPSHOT — teen khaane jo kabhi nahi badalte.
   *
   * 🔴 Ye `Customer` ke aane ke BAAD bhi yahin hain aur yahin rahenge. Wahan
   * sirf aakhri haal hai; yahan wo hai jo IS order ke waqt likha gaya tha. Parcel usi
   * pate par gaya tha, aur wapsi ke jhagre mein sawal hamesha usi waqt ka hota hai.
   */
  customerName    String
  customerPhone   String
  customerAddress String
  /// Kis customer ka — purane order par `null` (backfill se pehle ke)
  customerId      String?
  locationLat     Float? // 🔴 RTO ka sab se bara lever
  locationLng     Float?
  area            String
  subtotal        Int
  deliveryFee     Int
  discount        Int           @default(0)
  total           Int
  bajiFee         Int // hamara revenue — snapshot prices se calculate
  feeRateBps      Int
  paymentMethod   PaymentMethod @default(COD)
  status          OrderStatus   @default(PENDING_CONFIRM)
  idempotencyKey  String?       @unique

  confirmSentAt     DateTime?
  /// 6 ghante baad reseller ko yaad dilaya gaya (ek hi baar — roz ka nag nahi)
  reminderSentAt    DateTime?
  /// Raste mein khare order par dukan se poochha gaya (ek hi baar)
  transitReminderAt DateTime?
  confirmedAt       DateTime? // 🔴 null = supplier ko ja hi nahi sakta
  // Phase 1 mein reseller khud confirm karti hai (wo customer se baat kar chuki hoti hai).
  // Ye field isliye hai ke baad mein RTO ka moqabla ho sake: reseller-confirmed vs
  // customer-confirmed. Number khud batayega ke confirmation bot ki zaroorat hai ya nahi.
  confirmedBy       ConfirmedBy?
  sentToSupplierAt  DateTime?
  acceptedAt        DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  /**
   * Wholesaler ka darwaza — is link se wo bina login ke order dekh kar accept/reject
   * karta hai. Token opaque aur ek order ke liye khaas hai.
   * 🔴 Login is liye nahi ke Bolton Market ka thok wala naya account nahi banata,
   * magar WhatsApp ka link zaroor kholta hai. Token hi us ki chabi hai —
   * is liye wo lamba (32 bytes) aur sirf isi order par chalta hai.
   */
  supplierToken     String?      @unique
  dispatchedAt      DateTime?
  /// kis courier ke haath — `self` ka matlab dukan ka apna rider (koi CN nahi)
  courier           String?
  /// CN number, space/dash hata kar bara haroof mein
  trackingNo        String?
  deliveredAt       DateTime?
  rtoReason         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  reseller  Reseller         @relation(fields: [resellerId], references: [id])
  supplier  Supplier         @relation(fields: [supplierId], references: [id])
  customer  Customer?        @relation(fields: [customerId], references: [id])
  items     OrderItem[]
  events    OrderEvent[]
  messages  OrderMessage[]
  reviews   SupplierReview[]
  feeLedger FeeLedger?
  payout    ResellerPayout?
  bonuses   ResellerBonus[]

  @@index([status, createdAt])
  @@index([resellerId, createdAt])
  @@index([supplierId, createdAt])
  @@index([confirmedAt, status])
  /// Number ka record — DO jagah chalta hai, aur dono jagah koi INTEZAR kar raha hota
  /// hai: reseller order lagate waqt (safha khula hua hai), aur dukan order qubool karte
  /// waqt ("isi number par pehle kya hua"). Bina index ke dono poori table parhti hain.
  @@index([customerPhone, status])
  /// Ilaqe ka chalan — wapsi ke andaze ke liye, dukan ke har order-safhe par
  @@index([area, status])
}

enum PaymentMethod {
  COD
  PREPAID
}

enum ConfirmedBy {
  RESELLER // Phase 1 — reseller customer se baat kar ke confirm karti hai
  CUSTOMER // Phase 2 — WhatsApp bot par customer khud "HAAN" likhta hai
  OPS // coordinator ne phone par confirm kiya
}

enum OrderStatus {
  PENDING_CONFIRM
  CONFIRMED
  SENT_TO_SUPPLIER
  /// Wholesaler ne qubool kiya — maal mojood hai aur wo bhej raha hai
  ACCEPTED
  /// Maal bandh diya, courier ka intezar — wholesaler ka apna qadam
  PACKED
  /// Wholesaler ne mana kiya (maal khatam / ilaqa door) — order CANCELLED ho jata hai
  REJECTED
  DISPATCHED
  DELIVERED
  RTO
  CANCELLED
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  qty       Int     @default(1)
  /**
   * Kitne WAPAS aaye — adhoori wapsi.
   *
   * 🔴 `qty` ko ghatate NAHI hain. Wo us waqt ka snapshot hai: itna maal bheja
   * gaya tha, aur us par courier ka kharcha aur dukan ki mehnat lag chuki hai. Ghatane
   * ka matlab hota ke teen mahine baad koi dekhe aur samajhe ke sirf do hi bheje gaye
   * the — aur wapsi ka poora nuqsan tareekh se gayab ho jata.
   *
   * `0` = kuch wapas nahi aaya, aur wohi aam soorat hai.
   */
  returnedQty Int    @default(0)

  // 🔴 SNAPSHOTS — prices badalti rehti hain, history nahi badalni chahiye
  supplierPriceSnapshot Int
  bajiPriceSnapshot     Int
  retailPriceSnapshot   Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

/// Immutable audit log — order ki har harkat. Update kabhi nahi, sirf insert.
/**
 * Order ke gird ki baat — aur us mein "masla hua" bhi.
 * 🔴 Ye EK nizam hai, do nahi — aur ye faisla poore feature ki jaan hai.
 * Pehli nazar mein "baat karna" aur "shikayat karna" do alag cheezein lagti hain. Hain
 * nahi: shikayat bhi order ke saath juri hui ek baat hi hai, bas us par nishan laga hota
 * hai ke ye masla hai. Do alag nizam banane ka matlab hota ke ek hi guftagu do jagah
 * bant jaye — aur jab ops ko faisla karna ho to usay dono jagah parhni parti.
 * `kind` sirf ye batata hai ke ye baat kis darje ki hai. `ISSUE` par order ka safha
 * usay numaya karta hai aur ops ki list mein aa jata hai; `NOTE` aam baat hai.
 * 🔴 Ye WhatsApp ki jagah nahi le raha — wo hamesha tez rahega. Ye us cheez ke liye hai
 * jo BAAD mein kaam aati hai: jab dono ki baat alag ho aur koi faisla karna ho, to
 * platform ke paas kuch to ho. Abhi us waqt kuch bhi nahi hota.
 */
/**
 * Reseller ki raye us dukan ke bare mein jis se us ne kharida.
 * 🔴 Ye ORDER ke data ka mutabadil nahi, us ka doosra pehlu hai.
 * Order se sirf ye pata chalta hai ke dukan ne qubool kiya ya rad, aur kitni jaldi bheja.
 * Wo ye KABHI nahi bata sakta ke maal ka kya haal tha, baat karne mein kaisa hai, ya
 * commission waqt par diya ya nahi. Wo teen cheezein sirf reseller jaanti hai — aur
 * asal mein wohi teen us ka faisla banati hain.
 * 🔴 Ek reseller, ek dukan, ek MAHINA — is se zyada nahi (`@@unique`).
 * Bina is hadd ke ye do tarah se toot ta hai: naraz reseller ek hi din mein das buri
 * raye daal kar dukan ka record khatam kar sakti hai, aur dost dukan wala apni jaan
 * pehchan se sau achhi raye bharwa sakta hai. Mahine ki hadd dono raste band karti hai,
 * aur us se ye bhi milta hai ke record WAQT ke saath badalta hai — jo dukan pehle bura
 * tha aur ab sudhar gaya, us ka pichhla mahina us ke gale nahi parta.
 */
model SupplierReview {
  id         String @id @default(cuid())
  supplierId String
  resellerId String
  /// Kis order ke baad poochha gaya — raye us tajurbe se bandhi rehni chahiye.
  orderId    String

  /// 1–5. Maal kaisa nikla — sab se ahem, kyunke customer isi par wapas karta hai.
  quality       Int
  /// 1–5. Baat karne mein kaisa hai — jawab deta hai ya nahi.
  communication Int
  /// 1–5. Commission waqt par diya ya nahi.
  payoutOnTime  Int

  /// Ikhtiyari — ginti se jo baat nahi hoti wo yahan.
  comment String?

  /**
   * `YYYY-MM` — mahine ki hadd isi par lagti hai.
   * 🔴 Ye khana alag se rakha hai, `createdAt` se nikala nahi jata: Postgres ke unique
   * index mein hisaab nahi lag sakta, aur hadd DATABASE par honi chahiye — sirf code par
   * rakhne ka matlab hai ke do request ek saath aa kar dono nikal jayen.
   */
  periodMonth String

  createdAt DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  reseller Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([resellerId, supplierId, periodMonth], name: "onePerMonth")
  @@index([supplierId, createdAt])
}

model OrderMessage {
  id         String           @id @default(cuid())
  orderId    String
  kind       OrderMessageKind @default(NOTE)
  /// reseller | supplier | ops
  authorType String
  /// Kis ne likha — `ops` par OpsUser ki id, warna reseller/supplier ki.
  authorId   String?
  body       String
  /**
   * Maal ki tasveer — "aisa aaya hai" wali baat lafzon se nahi hoti.
   * 🔴 URL hamari apni storage ka hona lazmi hai; jaanch server par hoti hai. Bahar ka
   * link lene ka matlab hota ke koi hamare safhe par kisi bhi pate ki tasveer chipka de.
   */
  photoUrl   String?
  /// Masla hal ho gaya — sirf `ISSUE` par maani rakhta hai.
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  /// Ops ki list: khule hue masle, naye pehle
  @@index([kind, resolvedAt, createdAt])
}

enum OrderMessageKind {
  NOTE
  ISSUE
}

model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorType  String // reseller | supplier | ops | system | customer
  actorId    String?
  note       String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// ============================================================ FEE LEDGER (revenue)

/**
 * Reseller ke paise — wo 450 jo customer ne diye aur wholesaler ke paas hain.
 * Ye FeeLedger ka jorha hai, ulta rukh: FeeLedger mein wholesaler HUMEIN dena hai,
 * yahan wholesaler RESELLER ko dena hai. Dono rows ek hi lamhe banti hain — jab maal
 * pohanchta hai.
 * COD ka sach ye hai ke paisa wholesaler ke haath mein jata hai. Hum beech mein nahi
 * hain, is liye hum "paisa bhej diya" ko dekh nahi sakte — sirf DONO taraf se pooch
 * sakte hain. Isi liye do alag khaane hain: `sentAt` (wholesaler ka dawa) aur
 * `confirmedAt` (reseller ki tasdeeq). Sirf dono milne par hisab band hota hai.
 * 🔴 Ek taraf ka dawa kaafi kyun nahi: agar wholesaler ke "bhej diya" par row band ho
 * jati to hamare paas ye jaanne ka koi zariya na hota ke reseller ko waqai mile ya nahi
 * — aur reseller hamare paas hi aati hai, wholesaler ke paas nahi.
 */
model ResellerPayout {
  id         String       @id @default(cuid())
  orderId    String       @unique // har delivered order par exactly ek row
  resellerId String
  supplierId String
  amount     Int // retail - bajiPrice, snapshot se — baad mein rate badle to ye nahi badalta
  /**
   * Us waqt ki shart ka snapshot — der isi se napi jati hai.
   * 🔴 Dukan ki mojooda shart se na napen: 10 din ka baqaya khare hone par wo shart 15
   * din kar ke apna record saaf kar leta, aur "der" ka poora pemana bekar ho jata.
   */
  termDays   Int          @default(3)
  status     PayoutStatus @default(PENDING)

  /// wholesaler ka dawa — "bhej diye"
  sentAt        DateTime?
  /// EasyPaisa/bank ka TID — jhagre mein yehi ek cheez asli hai
  sentReference String?
  /**
   * Bhejne ki tasveer — marzi ka, magar jhagre mein sab se bhaari.
   *
   * 🔴 TID lazmi hai aur ye nahi, aur ye tarteeb jaan boojh kar hai: TID likhna
   * ek line ka kaam hai, screenshot lagana teen qadam ka. Screenshot lazmi karne ka
   * anjaam ye hota ke dukan wala "bhej diye" likhna hi chhor deta, aur hisab khula
   * reh jata — jo us se buri soorat hai ke sabooot adhoora ho.
   *
   * 🔴 URL hamari apni storage ka hona lazmi hai, aur jaanch server par hoti
   * hai. Bahar ka link lene ka matlab hota ke koi reseller ke safhe par kisi bhi pate
   * ki tasveer chipka de — ya us se kisi aur ki tasveer ka rasta khul jaye.
   */
  sentProofUrl  String?
  /// reseller ki tasdeeq — "mil gaye"
  confirmedAt   DateTime?
  /// reseller ne kaha nahi mile
  disputedAt    DateTime?
  disputeNote   String?
  /// ops ne faisla kiya (dono ke beech phansne par)
  resolvedById  String?
  resolvedAt    DateTime?
  resolveNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order    Order    @relation(fields: [orderId], references: [id])
  reseller Reseller @relation(fields: [resellerId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId, status])
  @@index([resellerId, status])
  // Admin ki screen: sab se purana baqaya sab se upar
  @@index([status, createdAt])
}

enum PayoutStatus {
  /// maal pohanch gaya, paise wholesaler ke paas hain
  PENDING
  /// wholesaler ka dawa: bhej diye
  SENT
  /// reseller ki tasdeeq: mil gaye — hisab band
  SETTLED
  /// reseller: nahi mile
  DISPUTED
}

model FeeLedger {
  id            String    @id @default(cuid())
  orderId       String    @unique // har order par exactly ek row
  supplierId    String
  amount        Int
  status        FeeStatus @default(PENDING)
  invoiceId     String?
  /// kis mahine ke invoice mein gayi — "2026-08"
  invoicePeriod String?
  /// maal kab pohancha — isi tareekh se mahine ka hisab banta hai
  earnedAt      DateTime?
  invoicedAt    DateTime?
  collectedAt   DateTime?
  createdAt     DateTime  @default(now())

  order    Order    @relation(fields: [orderId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId, status])
  @@index([status, createdAt])
  @@index([invoiceId])
}

/**
 * Fee ka safar: PENDING (order chal raha hai) → EARNED (maal pohanch gaya) →
 * INVOICED (bill bana) → COLLECTED (paisa aa gaya). RTO/mana par WRITTEN_OFF.
 * 🔴 EARNED alag hona zaroori hai: hamari kamai tab banti hai jab maal customer tak
 * pohanche. Bina is ke raste mein para hua order bhi "kamai" gina jata tha aur invoice
 * mein chala jata — aur agar wo wapas aa jata to hum wholesaler ko pehle hi bill kar
 * chuke hote.
 */
enum FeeStatus {
  PENDING
  EARNED
  INVOICED
  COLLECTED
  WRITTEN_OFF
}

// ============================================================ CONTENT PACKS (supplier revenue)

model ContentPack {
  id          String     @id @default(cuid())
  supplierId  String
  skuCount    Int
  price       Int
  status      PackStatus @default(ORDERED)
  invoiceId   String?
  deliveredAt DateTime?
  createdAt   DateTime   @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId, status])
}

enum PackStatus {
  ORDERED
  SHOOTING
  DESIGNING
  DELIVERED
}

/// Atomic counters — order number (BJ-1043) isi se banta hai.
/// Sequence ke bajaye model isliye ke ye portable hai aur test mein fake ho jata hai.
model Counter {
  id    String @id
  value Int    @default(0)
}

// ============================================================ AUTH

model OpsUser {
  id         String    @id @default(cuid())
  name       String
  email      String    @unique
  // 🔴 Login WhatsApp OTP se hota hai — poore system mein koi password nahi hai,
  // aur ops ke liye alag tareeqa banane ka matlab ek aur cheez ka toot-na.
  phone      String?   @unique
  role       OpsRole   @default(REVIEWER)
  isActive   Boolean   @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  sessions   Session[]
}

/**
 * Ops ke darjay — barhte hue. Har role ka ikhtiyar ek hi jagah likha hai:
 * packages/core/src/domain/ops-permissions.ts
 */
enum OpsRole {
  REVIEWER
  COORDINATOR
  MANAGER
  SUPER_ADMIN
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique // 🔴 plain token kabhi store nahi hota
  resellerId String?
  opsUserId  String?
  supplierId String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?

  reseller Reseller? @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  opsUser  OpsUser?  @relation(fields: [opsUserId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([resellerId])
  @@index([supplierId])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

// ============================================================ WHATSAPP

model WhatsappMessage {
  id          String    @id @default(cuid())
  orderId     String?
  resellerId  String?
  toPhone     String
  template    String?
  payload     Json
  direction   Direction
  status      String // queued | sent | delivered | read | failed
  waMessageId String?   @unique
  errorCode   String?
  createdAt   DateTime  @default(now())

  @@index([toPhone, createdAt])
  @@index([status, createdAt])
}

enum Direction {
  IN
  OUT
}

// ============================================================ ANALYTICS

model Event {
  id         String   @id @default(cuid())
  actorType  String
  actorId    String?
  name       String
  properties Json
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
  @@index([actorId, createdAt])
}

/// Customer apna pata KHUD likhti hai — reseller ke haath se nahi.
///
/// 🔴 Ye khaana RTO ke liye hai, sahulat ke liye nahi.
///
/// Ab tak raasta ye tha: customer WhatsApp par "haan chahiye" likhti, aur reseller us
/// ki baat parh kar naam, number aur pata KHUD type karti. Har ghalat harf ek wapas
/// aane wala parcel hai — aur us wapsi ka kiraya dono taraf ka dukan bharti hai,
/// jabke sakh reseller ki jati hai.
///
/// Aur ek cheez jo pehle mumkin hi nahi thi: customer ka apna GPS pin. Order wale
/// form mein sirf "MERI abhi ki location" ka button hai (aur wo theek likha hai) —
/// magar jab customer WhatsApp par apni location bhejti thi, usay daalne ka koi
/// khaana hi nahi tha. Ab wo pin customer ke apne phone se, ek tap mein aata hai.
model AddressRequest {
  id          String  @id @default(cuid())
  /// 32 bytes — link WhatsApp par jata hai, is liye andaza lagana namumkin hona chahiye
  token       String  @unique
  resellerId  String
  productId   String
  variantId   String?
  qty         Int     @default(1)
  /// Us waqt ka retail — customer ko yehi dikhta hai, aur baad mein badal jane par bhi
  /// wohi rehta hai jo usay dikhaya gaya tha
  retailPrice Int

  /// Neeche ke khaane CUSTOMER bharti hai
  customerName    String?
  customerPhone   String?
  customerAddress String?
  area            String?
  locationLat     Float?
  locationLng     Float?
  filledAt        DateTime?

  /// 🔴 Ek link se ek hi order. Warna wohi link dobara khol kar (ya forward kar ke)
  /// kai order ban sakte the — aur har order par dukan ka maal rok liya jata hai.
  orderId String?   @unique
  usedAt  DateTime?

  /// Purana link customer ke phone par pada reh jata hai. Bina hadd ke wo mahino baad
  /// khul kar us qeemat par order bana deta jo ab mojood hi nahi.
  expiresAt DateTime
  createdAt DateTime @default(now())

  reseller Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  /// Reseller ka safha: "kis kis ne pata bhej diya" — bhare hue, bina istemal ke
  @@index([resellerId, filledAt, usedAt])
}
